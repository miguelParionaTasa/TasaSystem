generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                    @id @default(autoincrement())
  firstName              String
  lastName               String
  areaId                 Int
  password               String
  username               String                 @unique
  isAdmin                Boolean                @default(false)
  isDeleted              Boolean                @default(false)
  activo                 Activo[]
  activoHistorial        ActivoHistorial[]
  Atributo               Atributo[]
  AtributoHistorial      AtributoHistorial[]
  clinica                Clinica[]
  clinicaHistorial       ClinicaHistorial[]
  componentes            Componente[]
  inventarioItems        InventarioItem[]       @relation("ResponsableInventario")
  otConsumibles          OTConsumible[]
  ots                    Ots[]
  procesos               Procesos[]
  procesosHistorial      ProcesosHistorial[]
  repuestos              Repuesto[]
  tarjetasRojas          TarjetaRoja[]
  tarjetasRojasHistorial TarjetaRojaHistorial[]
  area                   Area                   @relation(fields: [areaId], references: [id])
  zonas                  Zona[]                 @relation("UserToZona")
}

model Area {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model Ots {
  id                Int            @id @default(autoincrement())
  OT                String?
  equipoId          Int?
  descripcionEquipo String?
  zonaId            Int
  ubicacionId       Int?
  userId            Int
  ubicacionSinId    String?
  ottId             String?
  otConsumibles     OTConsumible[]
  equipo            Equipo?        @relation(fields: [equipoId], references: [id])
  OTbasico          OTbasico?      @relation(fields: [ottId], references: [OTmaximo])
  ubicacion         Ubicacion?     @relation(fields: [ubicacionId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
  zona              Zona           @relation(fields: [zonaId], references: [id])
}

model OTConsumible {
  id               Int         @id @default(autoincrement())
  consumibleId     Int?
  nombreConsumible String?
  unidadMedida     String?
  cantidad         Float?
  otId             Int
  userId           Int
  imageUrl         String?
  comentarios      String?
  estado           String?
  reservaSap       String?
  fechaCreacion    DateTime    @default(now())
  consumibleSap    String?
  consumible       Consumible? @relation(fields: [consumibleId], references: [id])
  ot               Ots         @relation(fields: [otId], references: [id])
  user             User        @relation(fields: [userId], references: [id])
  images           Image[]     @relation("ConsumibleImage")
}

model OTMovimientoSAP {
  id             Int       @id @default(autoincrement())
  otNumero       String
  descripcionOT  String?
  zona           String?
  ubicacion      String?
  comentarioOT   String?
  codigoMaterial String
  nombreMaterial String?
  unidadMedida   String?
  cantidad       Float
  reservaSAP     String?
  comentario     String?
  fechaPedido    DateTime?
}

model Consumible {
  id              Int               @id @default(autoincrement())
  name            String
  unidadMedida    String
  codMaximo       String
  nombreMaximo    String
  precio          Float?
  historico       Historico[]
  otConsumibles   OTConsumible[]
  OTConsumibleBot OTConsumibleBot[]
}

model Zona {
  id           Int          @id @default(autoincrement())
  name         String
  nombreMaximo String
  equipos      Equipo[]
  historico    Historico[]
  OTbasico     OTbasico[]
  ots          Ots[]
  predictivos  Predictivo[]
  ubicaciones  Ubicacion[]
  usuarios     User[]       @relation("UserToZona")
}

model Ubicacion {
  id            Int           @id @default(autoincrement())
  name          String
  nombreMaximo  String
  zonaId        Int
  clinicas      Clinica[]
  equipos       Equipo[]
  historico     Historico[]
  lubricaciones Lubricacion[]
  OTbasico      OTbasico[]
  ots           Ots[]
  predictivos   Predictivo[]
  procesos      Procesos[]
  zona          Zona          @relation(fields: [zonaId], references: [id])
}

model Lubricacion {
  id             Int        @id @default(autoincrement())
  zona           String
  equipo         String
  item           Int
  componente     String
  puntosLubricar Int
  cantidad       String
  lubricante     String
  frecuencia     String
  actividad      String
  ubicacionTexto String?
  ubicacionId    Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  ubicacion      Ubicacion? @relation(fields: [ubicacionId], references: [id])
  images         Image[]    @relation("LubricacionImage")
}

model Componente {
  id          Int        @id @default(autoincrement())
  equipoId    Int
  parteEquipo String
  imageUrl    String?
  userId      Int
  equipo      Equipo     @relation(fields: [equipoId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
  repuestos   Repuesto[]
  images      Image[]    @relation("ComponenteImage")
}

model Atributo {
  id                Int                 @id @default(autoincrement())
  nombre            String
  valor             String?
  userId            Int?
  equipoId          Int
  equipo            Equipo              @relation(fields: [equipoId], references: [id])
  user              User?               @relation(fields: [userId], references: [id])
  AtributoHistorial AtributoHistorial[]
  images            Image[]             @relation("AtributoImage")
}

model Clinica {
  id               Int                @id @default(autoincrement())
  nombre           String
  valor            String?
  userId           Int?
  ubicacionId      Int
  ot    String?   
  fecha DateTime  @default(now())
  ubicacion        Ubicacion          @relation(fields: [ubicacionId], references: [id])
  user             User?              @relation(fields: [userId], references: [id])
  ClinicaHistorial ClinicaHistorial[]
  images           Image[]            @relation("ClinicaImage")
}

model ClinicaHistorial {
  id            Int      @id @default(autoincrement())
  clinicaId     Int
  valorAnterior String?
  valorNuevo    String?
  userId        Int
  fechaCambio   DateTime @default(now())
  clinica       Clinica  @relation(fields: [clinicaId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model Activo {
  id              Int               @id @default(autoincrement())
  nombre          String
  valor           String?
  userId          Int?
  equipoId        Int?
  marca           String?
  modelo          String?
  serie           String?
  ubicacion       String?
  valor2          String?
  zona            String?
  historial       String?
  equipo          Equipo?           @relation(fields: [equipoId], references: [id])
  user            User?             @relation(fields: [userId], references: [id])
  activoHistorial ActivoHistorial[]
  images          Image[]           @relation("ActivoImage")
}

model ActivoHistorial {
  id            Int      @id @default(autoincrement())
  activoId      Int
  valorAnterior String?
  valorNuevo    String?
  userId        Int
  fechaCambio   DateTime @default(now())
  activo        Activo   @relation(fields: [activoId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model AtributoHistorial {
  id            Int      @id @default(autoincrement())
  atributoId    Int
  valorAnterior String?
  valorNuevo    String?
  userId        Int
  fechaCambio   DateTime @default(now())
  atributo      Atributo @relation(fields: [atributoId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model Repuesto {
  id           Int        @id @default(autoincrement())
  componenteId Int
  nombre       String
  descripcion  String?
  imageUrl     String?
  userId       Int
  componente   Componente @relation(fields: [componenteId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  images       Image[]    @relation("RepuestoImage")
}

model Equipo {
  id             Int          @id @default(autoincrement())
  name           String
  nombreMaximo   String
  zonaId         Int
  ubicacionId    Int
  imageUrl       String?
  ubicacionSinId String?
  activo         Activo[]
  atributos      Atributo[]
  componentes    Componente[]
  ubicacion      Ubicacion    @relation(fields: [ubicacionId], references: [id])
  zona           Zona         @relation(fields: [zonaId], references: [id])
  OTbasico       OTbasico[]
  ots            Ots[]
  predictivos    Predictivo[]
  images         Image[]      @relation("EquipoImage")
}

model Image {
  id            Int            @id @default(autoincrement())
  url           String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activo        Activo[]       @relation("ActivoImage")
  atributos     Atributo[]     @relation("AtributoImage")
  clinica       Clinica[]      @relation("ClinicaImage")
  componentess  Componente[]   @relation("ComponenteImage")
  consumibless  OTConsumible[] @relation("ConsumibleImage")
  equiposs      Equipo[]       @relation("EquipoImage")
  lubricaciones Lubricacion[]  @relation("LubricacionImage")
  predictivos   Predictivo[]   @relation("PredictivoImage")
  procesos      Procesos[]     @relation("ProcesosImage")
  repuestoss    Repuesto[]     @relation("RepuestoImage")
  tarjetasRojas TarjetaRoja[]  @relation("TarjetaRojaImage")
}

model OTbasico {
  id          Int        @id @default(autoincrement())
  name        String
  Temp        String
  OTmaximo    String     @unique
  estado      String
  zonaId      Int?
  ubicacionId Int?
  equipoId    Int?
  tecnico1    String?
  tecnico2    String?
  Equipo      Equipo?    @relation(fields: [equipoId], references: [id])
  Ubicacion   Ubicacion? @relation(fields: [ubicacionId], references: [id])
  Zona        Zona?      @relation(fields: [zonaId], references: [id])
  Ots         Ots[]
}

model Historico {
  id           Int        @id @default(autoincrement())
  zonaId       Int
  ubicacionId  Int
  consumibleId Int
  trabajo      String
  fecha        DateTime
  ot           String
  cantidad     Float
  consumible   Consumible @relation(fields: [consumibleId], references: [id])
  ubicacion    Ubicacion  @relation(fields: [ubicacionId], references: [id])
  zona         Zona       @relation(fields: [zonaId], references: [id])
}

model InventarioItem {
  id            Int             @id @default(autoincrement())
  descripcion   String
  cantidad      Int
  estado        String
  ubicacion     String
  nivel         String
  fechaIngreso  DateTime
  fechaSalida   DateTime?
  destino       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  responsableId Int
  imageUrl      String?
  historial     HistorialItem[]
  responsable   User            @relation("ResponsableInventario", fields: [responsableId], references: [id])
}

model HistorialItem {
  id             Int            @id @default(autoincrement())
  inventarioId   Int
  fechaUso       DateTime
  cantidadUsada  Float
  descripcionUso String
  destino        String
  responsable    String
  inventario     InventarioItem @relation(fields: [inventarioId], references: [id])
}

model Configuracion {
  id         Int     @id @default(1)
  fechaCorte String?
}

model Predictivo {
  id                      Int       @id @default(autoincrement())
  zonaId                  Int
  ubicacionId             Int
  equipoId                Int
  fecha                   DateTime  @default(now())
  tecnica                 String
  recomendacionProveedor  String?
  recomendacionPredictivo String?
  otGenerado              String?
  comentario              String?
  otRelacionada           String?
  equipo                  Equipo    @relation(fields: [equipoId], references: [id])
  ubicacion               Ubicacion @relation(fields: [ubicacionId], references: [id])
  zona                    Zona      @relation(fields: [zonaId], references: [id])
  images                  Image[]   @relation("PredictivoImage")
}

model Procesos {
  id                Int                 @id @default(autoincrement())
  nombre            String
  valor             String?
  userId            Int?
  ubicacionId       Int?
  ubicacion         Ubicacion?          @relation(fields: [ubicacionId], references: [id])
  user              User?               @relation(fields: [userId], references: [id])
  ProcesosHistorial ProcesosHistorial[]
  images            Image[]             @relation("ProcesosImage")
}

model ProcesosHistorial {
  id            Int      @id @default(autoincrement())
  procesoId     Int
  valorAnterior String?
  valorNuevo    String?
  userId        Int
  fechaCambio   DateTime @default(now())
  proceso       Procesos @relation(fields: [procesoId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model TarjetaRoja {
  id            Int                    @id @default(autoincrement())
  reporta       String
  dniReporta    String
  fecha         DateTime               @default(now())
  pet           String?
  zona          String?
  equipo        String?
  componente    String?
  descripcion   String?
  tipoDeteccion String?
  comentario1   String?
  comentario2   String?
  userId        Int?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User?                  @relation(fields: [userId], references: [id])
  historial     TarjetaRojaHistorial[]
  images        Image[]                @relation("TarjetaRojaImage")
}

model TarjetaRojaHistorial {
  id            Int         @id @default(autoincrement())
  tarjetaId     Int
  campo         String
  valorAnterior String?
  valorNuevo    String?
  userId        Int
  fechaCambio   DateTime    @default(now())
  tarjeta       TarjetaRoja @relation(fields: [tarjetaId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
}

model TelegramUser {
  id            BigInt   @id
  telegramId    String   @unique
  nombre        String?
  username      String?
  activo        Boolean  @default(true)
  fechaRegistro DateTime @default(now())
  otsBot        OTBot[]
}

model OTBot {
  id             Int               @id @default(autoincrement())
  otNumero       String            @unique
  descripcionOT  String?
  zona           String?
  ubicacion      String?
  avance         Float?
  responsable    String?
  estado         String?           @default("BORRADOR")
  telegramUserId BigInt?
  fechaCreacion  DateTime          @default(now())
  fechaActualiza DateTime          @updatedAt
  telegramUser   TelegramUser?     @relation(fields: [telegramUserId], references: [id])
  consumibles    OTConsumibleBot[]
}

model OTConsumibleBot {
  id               Int         @id @default(autoincrement())
  otBotId          Int
  consumibleId     Int?
  consumibleSap    String?
  nombreConsumible String?
  unidadMedida     String?
  cantidad         Float?
  comentarios      String?
  estado           String?
  reservaSap       String?
  fechaCreacion    DateTime    @default(now())
  consumible       Consumible? @relation(fields: [consumibleId], references: [id])
  otBot            OTBot       @relation(fields: [otBotId], references: [id])
}

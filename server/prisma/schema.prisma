generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                 @id @default(autoincrement())
  firstName         String
  lastName          String
  areaId            Int
  password          String
  username          String              @unique
  isAdmin           Boolean             @default(false)
  isDeleted         Boolean             @default(false)
  componentes       Componente[]
  otConsumibles     OTConsumible[]
  ots               Ots[]
  repuestos         Repuesto[]
  area              Area                @relation(fields: [areaId], references: [id])
  Atributo          Atributo[]
  AtributoHistorial AtributoHistorial[]
   procesos          Procesos[]
   procesosHistorial ProcesosHistorial[]
   activo          Activo[]
   activoHistorial ActivoHistorial[]
   clinica          Clinica[]
   clinicaHistorial ClinicaHistorial[]
  // Relación inversa (opcional si quieres ver quiénes han sido responsables)
  inventarioItems   InventarioItem[]   @relation("ResponsableInventario")
}

model Area {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model Ots {
  id                Int            @id @default(autoincrement())
  OT                String?
  equipoId          Int?
  descripcionEquipo String?
  zonaId            Int
  ubicacionId       Int?
  userId            Int
  ubicacionSinId    String?
  ottId             String?
  otConsumibles     OTConsumible[]
  equipo            Equipo?        @relation(fields: [equipoId], references: [id])
  OTbasico          OTbasico?      @relation(fields: [ottId], references: [OTmaximo])
  ubicacion         Ubicacion?     @relation(fields: [ubicacionId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
  zona              Zona           @relation(fields: [zonaId], references: [id])
}

model OTConsumible {
  id               Int         @id @default(autoincrement())
  consumibleId     Int?
  nombreConsumible String?
  unidadMedida     String?
  cantidad         Float?
  otId             Int
  userId           Int
  imageUrl         String?
  comentarios      String?
  estado           String?
  reservaSap       String?
  consumibleSap    String?     // ✅ nuevo campo
  fechaCreacion    DateTime    @default(now())
  consumible       Consumible? @relation(fields: [consumibleId], references: [id])
  ot               Ots         @relation(fields: [otId], references: [id])
  user             User        @relation(fields: [userId], references: [id])
  images           Image[]     @relation("ConsumibleImage")
}


model Consumible {
  id            Int            @id @default(autoincrement())
  name          String
  unidadMedida  String
  codMaximo     String
  nombreMaximo  String
  precio        Float?         
  otConsumibles OTConsumible[]
  historico Historico[]

}

model Zona {
  id           Int         @id @default(autoincrement())
  name         String
  nombreMaximo String
  equipos      Equipo[]
  OTbasico     OTbasico[]
  ots          Ots[]
  ubicaciones  Ubicacion[]
  historico Historico[]
  predictivos  Predictivo[]   // 👈 inversa aquí
}

model Ubicacion {
  id            Int           @id @default(autoincrement())
  name          String
  nombreMaximo  String
  zonaId        Int
  equipos       Equipo[]
  OTbasico      OTbasico[]
  ots           Ots[]
  zona          Zona          @relation(fields: [zonaId], references: [id])
  historico     Historico[]
  lubricaciones Lubricacion[]
  predictivos   Predictivo[]
  procesos      Procesos[]     // 🔹 inversa nueva
}



model Lubricacion {
  id             Int      @id @default(autoincrement())
  zona           String   // "2", "3.1", etc.
  equipo         String
  item           Int
  componente     String
  puntosLubricar Int
  cantidad       String
  lubricante     String
  frecuencia     String
  actividad      String

  // Campo editable libre en el front
  ubicacionTexto String?  

  // Relación opcional con Ubicacion existente
  ubicacionId    Int?
  ubicacion      Ubicacion? @relation(fields: [ubicacionId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relación con imágenes
  images         Image[] @relation("LubricacionImage")
}

model Componente {
  id          Int          @id @default(autoincrement())
  equipoId    Int
  parteEquipo String
  imageUrl    String?
  userId      Int
  equipo      Equipo       @relation(fields: [equipoId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  repuestos   Repuesto[]
  images      Image[]      @relation("ComponenteImage")
}

model Atributo {
  id                Int                 @id @default(autoincrement())
  nombre            String
  valor             String?
  userId            Int?
  equipoId          Int                 // ✅ ahora depende de componente
  user              User?               @relation(fields: [userId], references: [id])
  equipo            Equipo          @relation(fields: [equipoId], references: [id])
  AtributoHistorial AtributoHistorial[]
  images            Image[]             @relation("AtributoImage")
}

model Clinica {
  id                Int                 @id @default(autoincrement())
  nombre            String
  valor             String?
  userId            Int?
  equipoId          Int                 // ✅ ahora depende de componente
  user              User?               @relation(fields: [userId], references: [id])
  equipo            Equipo          @relation(fields: [equipoId], references: [id])
  ClinicaHistorial ClinicaHistorial[]
  images            Image[]             @relation("ClinicaImage")
}

model ClinicaHistorial {
  id            Int      @id @default(autoincrement())
  clinicaId    Int
  valorAnterior String?
  valorNuevo    String?
  userId        Int
  fechaCambio   DateTime @default(now())
  clinica      Clinica @relation(fields: [clinicaId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model Activo {
  id              Int               @id @default(autoincrement())
  nombre          String
  valor           String?
  valor2          String?           // 💡 segundo valor adicional
  marca           String?           // 💡 marca del activo
  modelo          String?           // 💡 modelo del activo
  serie           String?           // 💡 número de serie
  zona            String?           // 💡 texto libre (no relacionado a tabla)
  ubicacion       String?           // 💡 texto libre (no relacionado a tabla)

  userId          Int?
  equipoId        Int?              // ⚙️ ahora es opcional, ya no es restrictivo

  user            User?             @relation(fields: [userId], references: [id])
  equipo          Equipo?           @relation(fields: [equipoId], references: [id])

  activoHistorial ActivoHistorial[]
  images          Image[]           @relation("ActivoImage")
}


model ActivoHistorial {
  id            Int      @id @default(autoincrement())
  activoId    Int
  valorAnterior String?
  valorNuevo    String?
  userId        Int
  fechaCambio   DateTime @default(now())
  activo      Activo @relation(fields: [activoId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model AtributoHistorial {
  id            Int      @id @default(autoincrement())
  atributoId    Int
  valorAnterior String?
  valorNuevo    String?
  userId        Int
  fechaCambio   DateTime @default(now())
  atributo      Atributo @relation(fields: [atributoId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model Repuesto {
  id           Int        @id @default(autoincrement())
  componenteId Int
  nombre       String
  descripcion  String?
  imageUrl     String?
  userId       Int
  componente   Componente @relation(fields: [componenteId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  images       Image[]    @relation("RepuestoImage")
}

model Equipo {
  id             Int          @id @default(autoincrement())
  name           String
  nombreMaximo   String
  zonaId         Int
  ubicacionId    Int
  imageUrl       String?
  ubicacionSinId String?
  componentes    Componente[]
  atributos      Atributo[]   // 👈 Relación con Atributo
  ubicacion      Ubicacion    @relation(fields: [ubicacionId], references: [id])
  zona           Zona         @relation(fields: [zonaId], references: [id])
  OTbasico       OTbasico[]
  ots            Ots[]
  images         Image[]      @relation("EquipoImage")
    predictivos  Predictivo[]   // 👈 inversa aquí
    activo  Activo[] 
    clinica  Clinica[] 
}

model Image {
  id           Int            @id @default(autoincrement())
  url          String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  componentess Componente[]   @relation("ComponenteImage")
  consumibless OTConsumible[] @relation("ConsumibleImage")
  equiposs     Equipo[]       @relation("EquipoImage")
  repuestoss   Repuesto[]     @relation("RepuestoImage")
  atributos    Atributo[]     @relation("AtributoImage") // Nueva relación con Atributo
   clinica    Clinica[]     @relation("ClinicaImage")
   activo    Activo[]     @relation("ActivoImage")
   lubricaciones   Lubricacion[]  @relation("LubricacionImage") // inversa aquí
predictivos    Predictivo[]   @relation("PredictivoImage") // 👈 inversa aquí
 procesos        Procesos[]       @relation("ProcesosImage")
}

 

model OTbasico {
  id          Int        @id @default(autoincrement())
  name        String
  Temp        String
  OTmaximo    String     @unique
  estado      String
  zonaId      Int?
  ubicacionId Int?
  equipoId    Int?
  tecnico1    String?    // ← nuevo campo
  tecnico2    String?    // ← nuevo campo

  Equipo      Equipo?    @relation(fields: [equipoId], references: [id])
  Ubicacion   Ubicacion? @relation(fields: [ubicacionId], references: [id])
  Zona        Zona?      @relation(fields: [zonaId], references: [id])
  Ots         Ots[]
}

model Historico {
  id           Int         @id @default(autoincrement())
  zonaId       Int
  ubicacionId  Int
  consumibleId Int
  trabajo      String
  fecha        DateTime
  ot           String       // Puede ser Int si siempre es número
  cantidad     Float

  zona         Zona         @relation(fields: [zonaId], references: [id])
  ubicacion    Ubicacion    @relation(fields: [ubicacionId], references: [id])
  consumible   Consumible   @relation(fields: [consumibleId], references: [id])
}

model InventarioItem {
  id             Int       @id @default(autoincrement())
  descripcion    String
  cantidad       Int
  estado         String
  ubicacion      String
  nivel          String
  fechaIngreso   DateTime
  fechaSalida    DateTime?
  destino        String?

  responsableId  Int
  responsable    User      @relation("ResponsableInventario", fields: [responsableId], references: [id])

  historial      HistorialItem[]

  imageUrl       String?   // ← Cambiamos imageId/image por imageUrl

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}


model HistorialItem {
  id             Int      @id @default(autoincrement())
  inventarioId   Int
  fechaUso       DateTime
  cantidadUsada  Float
  descripcionUso String
  destino        String
  responsable    String
  inventario     InventarioItem @relation(fields: [inventarioId], references: [id])
}

model Configuracion {
  id        Int      @id @default(1) // solo habrá un registro
  fechaCorte String?
}

model Predictivo {
  id                    Int        @id @default(autoincrement())
  zonaId                Int
  ubicacionId           Int
  equipoId              Int
  fecha                 DateTime   @default(now())
  tecnica               String
  recomendacionProveedor String?
  recomendacionPredictivo String?
  otGenerado            String?
  comentario            String?
  otRelacionada         String?

  // Relaciones
  zona       Zona      @relation(fields: [zonaId], references: [id])
  ubicacion  Ubicacion @relation(fields: [ubicacionId], references: [id])
  equipo     Equipo    @relation(fields: [equipoId], references: [id])
  images     Image[]   @relation("PredictivoImage")
}

model Procesos {
  id                Int                 @id @default(autoincrement())
  nombre            String
  valor             String?
  userId            Int?
  ubicacionId       Int?                // 🔹 ahora depende de ubicación
  user              User?               @relation(fields: [userId], references: [id])
  ubicacion         Ubicacion?          @relation(fields: [ubicacionId], references: [id])
  ProcesosHistorial ProcesosHistorial[]
  images            Image[]             @relation("ProcesosImage")
}



model ProcesosHistorial {
  id              Int       @id @default(autoincrement())
  procesoId       Int
  valorAnterior   String?
  valorNuevo      String?
  userId          Int
  fechaCambio     DateTime  @default(now())
  proceso         Procesos  @relation(fields: [procesoId], references: [id])
  user            User      @relation(fields: [userId], references: [id])
}
